# Voice AI Provider: "bolna" (primary) | "vapi" (fallback) | "pipecat" (future)
VOICE_PROVIDER=bolna

# Bolna.ai
BOLNA_API_KEY=
BOLNA_API_URL=https://api.bolna.dev

# Vapi.ai (fallback)
VAPI_API_KEY=

# LLM for chat widget: "openai" or "anthropic" or "gemini"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local voice testing stack (Pipecat + Deepgram + Sarvam)
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Hybrid Voice Providers (AWS + ElevenLabs — production/WebSocket path)
AWS_REGION=ap-south-1
# AWS credentials should be configured via AWS CLI or IAM Role, not hardcoded here
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail SMTP (alerts)
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# App
BASE_URL=https://propbot.co.in
WEBHOOK_SECRET=          # long random string; also the /admin password

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (Calendar + sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Vobiz telephony API
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_API_URL=https://api.vobiz.ai/api/v1

# MSG91 OTP (legacy)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Deployment identifiers (keep out of committed docs)
AWS_ACCOUNT_ID=

# Render (optional)
RENDER_API_KEY=

# Analytics & marketing
GA_MEASUREMENT_ID=
WHATSAPP_NUMBER=        # digits only, no +91 (e.g. 9876543210)
DEMO_PHONE_NUMBER=      # digits only, no +91 — shows "Try a Demo Call" floating button
FOUNDERS_SLOTS=         # e.g. 7 — shows "First 10 Founders" banner
