# Voice AI Provider: "bolna" (primary) | "vapi" (fallback) | "pipecat" (future)
VOICE_PROVIDER=bolna

# Bolna.ai
BOLNA_API_KEY=
BOLNA_API_URL=https://api.bolna.dev

# Vapi.ai (fallback)
VAPI_API_KEY=

# LLM for chat widget: "openai" or "anthropic" or "gemini"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local voice testing stack (Pipecat + Deepgram + Sarvam)
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# Hybrid Voice Providers (AWS + ElevenLabs — production/WebSocket path)
AWS_REGION=ap-south-1
# AWS credentials should be configured via AWS CLI or IAM Role, not hardcoded here
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Telephony: Vobiz (configured in Bolna console, no direct env vars needed)

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail SMTP (alerts)
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# App
BASE_URL=https://propbot.onrender.com
WEBHOOK_SECRET=

# Analytics & marketing
GA_MEASUREMENT_ID=
WHATSAPP_NUMBER=        # digits only, no +91 (e.g. 9876543210)
DEMO_PHONE_NUMBER=      # digits only, no +91 — shows "Try a Demo Call" floating button
