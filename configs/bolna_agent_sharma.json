{
    "agent_name": "Priya - Sharma Properties",
    "agent_welcome_message": "Namaste! Sharma Properties mein aapka swagat hai. Main Priya hoon, aapki kya madad kar sakti hoon?",
    "agent_type": "conversational",
    "tasks": [
        {
            "task_type": "conversation",
            "tools_config": {
                "llm_agent": {
                    "provider": "openrouter",
                    "model": "anthropic/claude-sonnet-4-20250514",
                    "max_tokens": 500,
                    "temperature": 0.4,
                    "family": "anthropic",
                    "agent_flow_type": "streaming",
                    "system_prompt": "<<GENERATED BY ONBOARDING SCRIPT — see scripts/onboard_client.py>>"
                },
                "synthesizer": {
                    "provider": "elevenlabs",
                    "voice_id": "<<HINDI_FEMALE_VOICE_ID — find at elevenlabs.io/voices>>",
                    "model": "eleven_multilingual_v2",
                    "stability": 0.6,
                    "similarity_boost": 0.8
                },
                "transcriber": {
                    "provider": "deepgram",
                    "model": "nova-2",
                    "language": "multi",
                    "keywords": ["Hindi", "English", "property", "flat", "BHK"]
                },
                "input": {
                    "provider": "exotel",
                    "format": "pcm"
                },
                "output": {
                    "provider": "exotel",
                    "format": "pcm"
                }
            },
            "tools": [
                {
                    "name": "capture_lead",
                    "description": "Save the caller's lead information. Call this once you have collected their name, phone number, and at least two other details.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "name": {"type": "string", "description": "Caller's full name"},
                            "phone": {"type": "string", "description": "Caller's phone number"},
                            "budget_min": {"type": "integer", "description": "Minimum budget in INR"},
                            "budget_max": {"type": "integer", "description": "Maximum budget in INR"},
                            "preferred_area": {"type": "string", "description": "Preferred locality"},
                            "property_type": {"type": "string", "description": "2BHK, 3BHK, plot, villa"},
                            "urgency": {"type": "string", "enum": ["immediate", "1-3months", "3-6months", "exploring"]},
                            "viewing_time": {"type": "string", "description": "When they want to visit"},
                            "notes": {"type": "string", "description": "Additional requirements"}
                        },
                        "required": ["name", "phone"]
                    },
                    "url": "https://propbot.onrender.com/api/webhooks/voice",
                    "method": "POST"
                },
                {
                    "name": "lookup_property",
                    "description": "Search property listings when caller asks about specific properties, prices, or availability.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "query": {"type": "string", "description": "The property question to look up"}
                        },
                        "required": ["query"]
                    },
                    "url": "https://propbot.onrender.com/api/webhooks/voice",
                    "method": "POST"
                },
                {
                    "name": "escalate_to_agent",
                    "description": "Escalate to the human agent when caller requests or when you cannot answer after two attempts.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "reason": {"type": "string", "description": "Why the call is being escalated"},
                            "caller_phone": {"type": "string", "description": "Caller's phone if available"}
                        },
                        "required": ["reason"]
                    },
                    "url": "https://propbot.onrender.com/api/webhooks/voice",
                    "method": "POST"
                }
            ]
        }
    ],
    "metadata": {
        "client_id": "<<SHARMA_CLIENT_UUID — generated during onboarding>>"
    },
    "telephony_provider": "exotel",
    "phone_number": "<<EXOTEL_VIRTUAL_NUMBER>>"
}
